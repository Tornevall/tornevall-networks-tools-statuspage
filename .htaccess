<IfModule mod_dir.c>
    DirectoryIndex disabled
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # This repository can be mounted directly below a public web root (for
    # example /status/). Always serve the committed Vite production bundle,
    # never the TypeScript/Vite source tree.
    RewriteRule ^$ dist/index.html [L]
    RewriteRule ^dist(?:/|$) - [L]
    RewriteRule ^(.+)$ dist/$1 [L]
</IfModule>
